<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#121821">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Dugout">
<link rel="apple-touch-icon" href="icon-512.png">
<link rel="manifest" id="manifest" href="manifest.webmanifest">
<script>/* on the phone (https, the tunnel): keep the pairing key, install sw.js (the app keeps working
   with the PC off, showing the last data) */
(function () {
  var k = new URLSearchParams(location.search).get('key');
  try { if (k) localStorage.setItem('dugout.key', k); else k = localStorage.getItem('dugout.key'); } catch (e) {}
  if (!k) return;
  document.getElementById('manifest').href = 'manifest.webmanifest?key=' + encodeURIComponent(k);
  if (location.protocol === 'https:' && 'serviceWorker' in navigator)
    navigator.serviceWorker.register('sw.js?key=' + encodeURIComponent(k), {updateViaCache: 'none'})
      .then(function (r) { r.update(); }).catch(function () {});
})();</script>
<title>FL26 Dugout</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect rx='7' width='32' height='32' fill='%2322c55e'/%3E%3Cpath d='M6 20h20v4H6zM9 12h14v6H9z' fill='%23052e16'/%3E%3C/svg%3E">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="app">
  <aside class="side">
    <div class="brand">
      <div class="logo"><svg viewBox="0 0 32 32"><path d="M5 21h22v4H5zM8 12h16v7H8z"/></svg></div>
      <div><b>Dugout</b><small>FL26 · Master League</small></div>
    </div>
    <div class="club" id="club"></div>
    <nav id="nav">
      <button data-page="home" class="active"><i>⌂</i>Trang chủ</button>
      <button data-page="inbox"><i>✉</i>Hộp thư<span class="badge" id="nb-inbox"></span></button>
      <button data-page="match"><i>⚔</i>Trận tới<span class="badge soft" id="nb-match"></span></button>
      <button data-page="live"><i>◉</i>Trực tiếp<span class="badge livebadge" id="nb-live"></span></button>
      <button data-page="fixtures"><i>▦</i>Lịch thi đấu</button>
      <button data-page="squad"><i>☰</i>Đội hình<span class="badge soft" id="nb-squad"></span></button>
      <button data-page="market"><i>⇄</i>Chuyển nhượng</button>
      <button data-page="youth"><i>✿</i>Đội trẻ &amp; Regen</button>
      <button data-page="ai"><i>◎</i>AI dự đoán</button>
    </nav>
    <div class="side-foot" id="side-foot"></div>
  </aside>

  <div class="main">
    <header class="top">
      <div class="today" id="today">Đang mở…</div>
      <div class="live" id="live"></div>
      <button class="hchip hidden" id="hchip" title="Xem kết quả kiểm tra dữ liệu"></button>
      <span class="savechip" id="savechip"></span>
      <span class="winchip hidden" id="winchip"></span>
      <div class="sync"><span class="dot" id="sync-dot"></span><span id="sync-text">Đang khởi động…</span></div>
      <button class="ghost" id="btn-phone" title="Xem Dugout trên điện thoại (cùng Wi-Fi hoặc qua Tailscale)">📱 Điện thoại</button>
      <button class="ghost" id="btn-reload" title="Đọc lại save ngay">↻ Đọc lại save</button>
    </header>
    <div class="hbar hidden" id="hbar"></div>
    <section class="page active" id="page-home"></section>
    <section class="page" id="page-inbox"></section>
    <section class="page" id="page-match"></section>
    <section class="page" id="page-live"></section>
    <section class="page" id="page-fixtures"></section>
    <section class="page" id="page-squad"></section>
    <section class="page" id="page-market"></section>
    <section class="page" id="page-youth"></section>
    <section class="page" id="page-ai"></section>
  </div>
</div>

<div class="scrim hidden" id="scrim"></div>
<aside class="drawer hidden" id="drawer">
  <button class="close" id="drawer-close" title="Đóng (Esc)">×</button>
  <div id="drawer-body"></div>
</aside>
<div class="modal hidden" id="modal"><div class="modal-box"><button class="close" id="modal-close" title="Đóng">×</button><div id="modal-body"></div></div></div>
<div class="splash" id="splash"><div class="logo big"><svg viewBox="0 0 32 32"><path d="M5 21h22v4H5zM8 12h16v7H8z"/></svg></div><div>Đang mở Dugout…</div></div>
<script src="app.js"></script>
</body>
</html>
